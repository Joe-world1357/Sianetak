# Copy to .env for local development. Never commit .env. All secrets below are placeholders.
NODE_ENV=development
PORT=3000

# PostgreSQL 14+ (docker compose up -d db provides one matching this URL)
DATABASE_URL=postgres://sianetak:sianetak_dev@localhost:5432/sianetak
DATABASE_SSL=false

# Comma-separated browser origins allowed by CORS (mobile apps do not need CORS).
CORS_ORIGINS=http://localhost:8080

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-generate-a-random-48-byte-secret-value
OTP_PEPPER=change-me-generate-a-different-random-48-byte-value
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP delivery: dev (DEVELOPMENT ONLY — code is logged and returned in the API response) | none
# There is no production SMS provider integrated yet; production refuses OTP_PROVIDER=dev.
OTP_PROVIDER=dev
OTP_DEV_EXPOSE_CODE=true
OTP_LENGTH=6
# [Proposed] defaults — confirm with product/security before launch.
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# Per-IP request limits per minute.
THROTTLE_GLOBAL_PER_MINUTE=120
THROTTLE_AUTH_PER_MINUTE=10

# --- Sprint 2: uploads, requests and technician onboarding ---
# Private media storage: local (DEVELOPMENT/TEST ONLY — files on this server's disk) | none.
# Production refuses local; with none, uploads answer 503 MEDIA_STORAGE_UNAVAILABLE and requests
# without photos still work. Private object storage is not integrated yet.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./var/media
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_DOCUMENT_BYTES=10485760
MEDIA_MAX_PENDING_PER_USER=20

# Requests. [Proposed] defaults — confirm with product/operations (D-02, D-04, D-10).
REQUEST_TIME_ZONE=Africa/Cairo
REQUEST_MAX_PHOTOS=5
REQUEST_MAX_OPEN_PER_CUSTOMER=5
REQUEST_SCHEDULE_LEAD_MINUTES=120
REQUEST_SCHEDULE_DAYS_AHEAD=7
REQUEST_SLOT_WINDOWS=09:00-12:00,12:00-15:00,15:00-18:00,18:00-21:00
# Disclosed inspection fee in piastres (e.g. 5000 = EGP 50). Leave empty while D-02 is open:
# customers are then told no fee is collected at submission.
INSPECTION_FEE_MINOR=
# Approximate box around Aswan governorate: minLat,minLng,maxLat,maxLng. Replace with approved coverage.
SERVICE_REGION_BOUNDS=22.0,31.3,24.8,33.7

# Technician verification. [Proposed] — the document checklist is open decision D-06.
TECHNICIAN_MIN_DOCUMENTS=0
TECHNICIAN_ALLOW_RESUBMIT=true
